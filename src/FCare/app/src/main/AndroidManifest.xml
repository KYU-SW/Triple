<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect 읽기 권한 (기본설계서 3.1, PRM-01) -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- 앱이 꺼져 있을 때 읽기 (지원 기기에서만, 실기기 확인 필요) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- 점수 확정 알림 (개선사항 4, Android 13+ 실행 중 권한) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Gemini 문장 다듬기 (개선사항 2, 사용자가 동의한 경우만 사용) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Health Connect 앱이 설치돼 있는지 확인하기 위해 필요 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FCare">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FCare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            권한 사용 목적 설명 화면 (PRM-04).
            Health Connect는 이 화면이 선언돼 있어야 권한 요청을 허용한다.
        -->
        <activity
            android:name=".hc.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.FCare">
            <!-- Android 13 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14 이상 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".hc.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
